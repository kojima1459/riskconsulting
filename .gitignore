# ============================================================================
# リスク提案ナビ .gitignore
# ----------------------------------------------------------------------------
# 16章 NFR-S2: 本製品リポジトリに .xlsm 成果物と dist/ をコミットしない。
# 17章 T-46③ が `git check-ignore` でこの除外の実効を毎リリース検査する
# (tools/ship_check.py)。
# ============================================================================

# ビルド成果物(中間生成物 *.building.xlsm / 不良品 *.failed.xlsm を含む)
/dist/

# マクロ入りブック(=成果物 .xlsm)はリポジトリのどこにも置かない。
*.xlsm

# ※ 例外: build/template_skeleton.xlsm は「本物のExcelで作った vbaProject.bin の
#   供給元」であり、成果物ではなくビルド入力(自己インストーラの土台)である。
#   これだけは tracked にして配る(自己インストール機構を再現可能にするため。
#   12章§2/裁定書4 項目12)。中身はキー走査クリーン(tools/ship_check.py ② が
#   全パート展開して毎リリース検査する)。
!build/template_skeleton.xlsm

# ※ *.xlsx は一律には除外しない。docs/ 配下の .xlsx は「回収フォーマット」等の
#   仕様入力であってビルド成果物ではないため、意図的に追跡対象へ残す。
#   ビルドが吐く .xlsx(企業ドシエファイル等)は上の /dist/ で除外される。

# 開発時の副産物
__pycache__/
*.py[cod]
wintest/result_*.log
