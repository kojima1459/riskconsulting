# ============================================================================
# リスク提案ナビ .gitignore
# ----------------------------------------------------------------------------
# 16章 NFR-S2: 本製品リポジトリに .xlsm 成果物と dist/ をコミットしない。
# 17章 T-46③ が `git check-ignore` でこの除外の実効を毎リリース検査する
# (tools/ship_check.py)。
# ============================================================================

# ビルド成果物(中間生成物 *.building.xlsm / 不良品 *.failed.xlsm を含む)
/dist/

# マクロ入りブックはリポジトリのどこにも置かない。
# ※ build/template_skeleton.xlsm(本物のExcelで作った vbaProject.bin の供給元)も
#   これに該当する。テンプレートはリポジトリ経由では配らず、開発機へ個別に
#   置く運用とする(tools/README.md 参照)。
*.xlsm

# ※ *.xlsx は一律には除外しない。docs/ 配下の .xlsx は「回収フォーマット」等の
#   仕様入力であってビルド成果物ではないため、意図的に追跡対象へ残す。
#   ビルドが吐く .xlsx(企業ドシエファイル等)は上の /dist/ で除外される。

# 開発時の副産物
__pycache__/
*.py[cod]
wintest/result_*.log
